{
  "compilerOptions": {
    "rootDir": ".", 
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es2022",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["routes/**/*.ts", "db/**/*.ts", "config/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
